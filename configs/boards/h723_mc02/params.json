{
  "build": {
    "usbx": true
  },
  "bindings": {
    "remoter_uart": "uart5",
    "vt03_uart": "usart1",
    "referee_uart": "usart1",
    "can_buses": {
      "gimbal_link": {
        "bus": "fdcan3",
        "rx_header": "0xB2",
        "tx_header": "0xC1"
      }
    }
  },
  "can": {
    "fdcan1": {
      "id_type": "standard"
    },
    "fdcan2": {
      "id_type": "standard"
    },
    "fdcan3": {
      "id_type": "standard"
    }
  },
  "ahrs": {
    "solver": "quaternion_ekf",
    "imu_offset_x": 0.2,
    "imu_thread_priority": 3,
    "temp_thread_priority": 4,
    "target_temp": 45
  },
  "remoter": {
    "source": "ps2",
    "thread_priority": 9,
    "rx_timeout_ticks": 100,
    "offline_timeout_ticks": 120
  },
  "referee": {
    "thread_priority": 8
  },
  "test": {
    "auto_run_on_boot": false,
    "imu": false,
    "usart": false,
    "usb": false,
    "can": false,
    "remoter": false,
    "referee_ui": false,
    "gpio_leds": false,
    "motor_demo": false
  },
  "bmi088": {
    "boost_duty": 0.06,
    "reboost_duty": 0.05,
    "approach_start_duty": 0.044,
    "approach_end_duty": 0.029,
    "hold_max_duty": 0.04,
    "pid_kp": 300,
    "pid_ki": 0.06,
    "pid_kd": 100,
    "pid_max_out": 90,
    "pid_max_iout": 200,
    "pid_scalar_a": 3.5,
    "pid_scalar_b": 0.2
  },
  "ps2": {
    "backend": "gpio",
    "timer": "ps2_clock",
    "cmd": "pe13",
    "data": "pe9",
    "clk": "pa2",
    "cs": "pa0"
  }
}
