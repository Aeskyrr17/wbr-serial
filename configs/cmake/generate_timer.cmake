# Dedicated one-shot timer roles. IOC owns clocks, prescaler, OPM and NVIC.
set(timer_channel_count 0)
set(timer_roles "")
set(timer_hw "")
set(timer_enum "")
set(timer_binding_cases "")
string(JSON timer_role_count ERROR_VARIABLE timer_json_err LENGTH "${board_json}" bindings timers)
if(NOT timer_json_err AND timer_role_count GREATER 0)
    math(EXPR timer_last "${timer_role_count} - 1")
    foreach(index RANGE 0 ${timer_last})
        string(JSON role MEMBER "${board_json}" bindings timers ${index})
        _pnx_cpp_identifier("${role}" role_ident)
        if(NOT role STREQUAL role_ident)
            message(FATAL_ERROR "Timer role '${role}' must be a C++ identifier")
        endif()
        string(JSON timer GET "${board_json}" bindings timers ${role} timer)
        string(TOUPPER "${timer}" timer)
        pnx_ioc_hw_in_list("${PNX_IOC_TIM_HW}" "${timer}" timer_present)
        if(NOT timer_present OR NOT timer MATCHES "^TIM(6|7)$")
            message(FATAL_ERROR "One-shot role '${role}' requires an IOC-configured basic timer TIM6/TIM7")
        endif()
        if(timer IN_LIST timer_hw OR timer IN_LIST pwm_failsafe_timers)
            message(FATAL_ERROR "One-shot timer ${timer} already has another owner")
        endif()
        pnx_ioc_timer_has_update_dma("${PNX_IOC_LINES}" "${timer}" has_dma)
        pnx_ioc_get_value("${PNX_IOC_LINES}" "NVIC.TimeBaseIP" timebase)
        if(timer STREQUAL timebase)
            message(FATAL_ERROR "One-shot timer ${timer} is the HAL timebase")
        endif()
        pnx_ioc_get_value("${PNX_IOC_LINES}" "VP_${timer}_VS_OPM.Mode" opm)
        pnx_ioc_get_value("${PNX_IOC_LINES}" "NVIC.${timer}_IRQn" irq)
        if(irq STREQUAL "")
            pnx_ioc_get_value("${PNX_IOC_LINES}" "NVIC.${timer}_DAC_IRQn" irq)
        endif()
        if(has_dma OR NOT opm STREQUAL "OPM_bit" OR NOT irq MATCHES "^true")
            message(FATAL_ERROR "One-shot timer ${timer} needs IOC OPM + IRQ and no update DMA")
        endif()
        pnx_ioc_get_value("${PNX_IOC_LINES}" "${timer}.Prescaler" prescaler)
        if(NOT prescaler MATCHES "^[0-9 ()+*/-]+$")
            message(FATAL_ERROR "Invalid IOC prescaler for ${timer}")
        endif()
        pnx_ioc_timer_clock_hz("${PNX_IOC_LINES}" "${timer}" clock_hz)
        math(EXPR counter_clock "(${prescaler} + 1) * 1000000")
        if(NOT counter_clock EQUAL clock_hz)
            message(FATAL_ERROR "One-shot timer ${timer} requires a 1 MHz IOC counter")
        endif()
        string(TOLOWER "${timer}" timer_lower)
        string(APPEND timer_enum "    ${role} = ${index},\n")
        string(APPEND timer_binding_cases
            "    case channel::${role}: out = { &h${timer_lower}, ${clock_hz}U }${generated_semicolon_token} return true${generated_semicolon_token}\n")
        list(APPEND timer_roles "${role}")
        list(APPEND timer_hw "${timer}")
    endforeach()
    set(timer_channel_count ${timer_role_count})
endif()

_pnx_write_generated("${OUT_DIR}/timer_config.hpp"
    "#pragma once\n#include <cstddef>\n#include <cstdint>\n\n"
    "namespace bsp::timer {\n"
    "enum class channel : std::uint8_t {\n${timer_enum}    none = 255\n}${generated_semicolon_token}\n"
    "inline constexpr std::size_t channel_count = ${timer_channel_count}${generated_semicolon_token}\n"
    "} // namespace bsp::timer\n")

set(PS2_GPIO_ASYNC 0)
set(ps2_async_include "")
set(ps2_gpio_transport "ps2_gpio")
set(ps2_timer_argument "")
if(HAS_PS2_DEVICE AND PS2_BACKEND_GPIO)
    string(JSON ps2_timer ERROR_VARIABLE timer_json_err GET "${params_json}" ps2 timer)
    if(NOT timer_json_err AND NOT ps2_timer STREQUAL "")
        if(NOT ps2_timer IN_LIST timer_roles)
            message(FATAL_ERROR "params.ps2.timer '${ps2_timer}' is not a board timer role")
        endif()
        set(PS2_GPIO_ASYNC 1)
        set(ps2_gpio_transport "ps2_gpio_async")
        set(ps2_timer_argument ", bsp::timer::channel::${ps2_timer}")
        set(ps2_async_include "#include \"ps2_gpio_async.hpp\"\n")
    endif()
endif()
