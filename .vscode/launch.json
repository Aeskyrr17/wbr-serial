{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STM32 Debug (DAP)",
      "type": "cortex-debug",
      "serverpath": "openocd",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${command:cmake.buildDirectory}/pnx_embedded.elf",
      "preLaunchTask": "cmake-build-debug",
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "${command:cmake.buildDirectory}/pnx-openocd.cfg"
      ],
      "runToEntryPoint": "main",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 20
      }
    },
    {
      "name": "STM32 Debug (STLink)",
      "type": "cortex-debug",
      "serverpath": "openocd",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${command:cmake.buildDirectory}/pnx_embedded.elf",
      "preLaunchTask": "cmake-build-debug",
      "configFiles": [
        "interface/stlink.cfg",
        "${command:cmake.buildDirectory}/pnx-openocd.cfg"
      ],
      "runToEntryPoint": "main",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 20
      }
    },
    {
      "type": "cortex-kit",
      "request": "attach",
      "name": "Cortex Kit: Live Plot (Attach)",
      "cwd": "${workspaceFolder}",
      "chip": "STM32H723VG",
      "programBinary": "${workspaceFolder}/build/h723-debug/pnx_embedded.elf",
      "probe": {
        "selector": "Horco CMSIS-DAP,SN:682623202833",
        "protocol": "swd",
        "speedKHz": 10000,
        "connectUnderReset": false
      },
      "flashing": {
        "enabled": false,
        "verify": false,
        "resetAfter": false
      },
      "acquisition": {
        "requestedSamplesPerSecond": 100000,
        "maxBurstMs": 2,
        "historySeconds": 30
      },
      "svdFile": null,
      "plotOnly": true,
      "stopOnEntry": false
    },
    {
      "type": "cortex-kit",
      "request": "launch",
      "name": "Cortex Kit: Flash & Debug",
      "cwd": "${workspaceFolder}",
      "chip": "STM32H723VG",
      "programBinary": "${workspaceFolder}/build/h723-debug/pnx_embedded.elf",
      "probe": {
        "selector": "Horco CMSIS-DAP,SN:682623202833",
        "protocol": "swd",
        "speedKHz": 10000,
        "connectUnderReset": false
      },
      "flashing": {
        "enabled": true,
        "verify": true,
        "resetAfter": true
      },
      "acquisition": {
        "requestedSamplesPerSecond": 100000,
        "maxBurstMs": 2,
        "historySeconds": 30
      },
      "svdFile": null
    }
  ]
}
